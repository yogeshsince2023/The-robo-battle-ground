# Copy this file to .env and fill in real values before deploying.

# Database (MySQL). Create the database first (e.g. `CREATE DATABASE robo_battleground;`),
# then point this at it. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/robo_battleground"

# Session signing secret for admin auth (JWT). Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-min-32-characters"

# Public site URL (used for SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Notification integrations (optional). Leave disabled until you wire up a provider.
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_PROVIDER_API_KEY=
NOTIFY_EMAIL_TO=

NOTIFY_WHATSAPP_ENABLED=false
NOTIFY_WHATSAPP_PROVIDER_API_KEY=
NOTIFY_WHATSAPP_TO=

# Directory (outside the public web root) where uploaded CAD/design files are stored
UPLOAD_DIR=./private-uploads

# Used only by prisma/seed.ts to set the first admin's credentials
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
