# Copy this file to .env and fill in real values before deploying.

# ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — Transaction Mode (pooler, port 6543)
# Get from: Supabase Dashboard → Project Settings → Database → Connection pooling
# Used at runtime by Next.js (Vercel serverless functions)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=10"

# Supabase PostgreSQL — Direct connection (port 5432)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Used only for `prisma migrate deploy` and `prisma db seed` (run locally or in CI)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ──────────────────────────────────────────────────────────────────
# Supabase Storage — for uploaded CAD/design files (private bucket)
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"   # secret — never expose this in the browser
SUPABASE_STORAGE_BUCKET="machining-uploads"            # must be created as a Private bucket in the dashboard

# ──────────────────────────────────────────────────────────────────
# Session signing secret for admin auth (JWT). Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-min-32-characters"

# Public site URL (used for SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://your-vercel-domain.vercel.app"

# Notification integrations (optional). Leave disabled until you wire up a provider.
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_PROVIDER_API_KEY=
NOTIFY_EMAIL_TO=

NOTIFY_WHATSAPP_ENABLED=false
NOTIFY_WHATSAPP_PROVIDER_API_KEY=
NOTIFY_WHATSAPP_TO=

# Used only by prisma/seed.ts to set the first admin's credentials
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
