// Prisma schema for RoboWar Arena business platform
// Database: Supabase PostgreSQL (free tier)
// Connection pooling via Transaction Mode (port 6543) for serverless (Vercel)
// Direct connection (port 5432) used only for migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- ADMIN / AUTH ----------

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role String @default("ADMIN")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- ARENA ----------

model ArenaEnquiry {
  id             String        @id @default(cuid())
  referenceNo    String        @unique
  name           String
  company        String?
  email          String
  phone          String
  eventName      String?
  eventDate      DateTime?
  participants   Int?
  robotCategory  String?
  expectedRobots Int?
  arenaDuration  String?
  location       String?
  message        String?
  status String @default("NEW")
  adminNotes     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ---------- TRAINING ----------

model TrainingCourse {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  shortDescription     String
  detailedDescription  String
  duration             String
  mode                 String
  fees                 String
  eligibility          String?
  skillsCovered        String? // comma separated
  modules              String? // JSON string of module list
  certificateAvailable Boolean  @default(true)
  status               String   @default("Active") // Active / Inactive
  displayOrder         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  enquiries TrainingEnquiry[]
}

model TrainingEnquiry {
  id             String          @id @default(cuid())
  referenceNo    String          @unique
  studentName    String
  email          String
  phone          String
  organization   String?
  courseId       String?
  course         TrainingCourse? @relation(fields: [courseId], references: [id])
  preferredBatch String?
  trainingMode   String?
  message        String?
  status String @default("NEW")
  adminNotes     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ---------- CERTIFICATES ----------

model Certificate {
  id                 String            @id @default(cuid())
  certificateId      String            @unique // e.g. RB-TRAIN-2026-00125
  studentName        String
  courseName         String
  trainingDuration   String?
  issueDate          DateTime
  completionDate     DateTime?
  status String @default("VALID")
  certificateFileUrl String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

// ---------- MACHINING ----------

model MachiningService {
  id           String   @id @default(cuid())
  category     String // CNC / VMC / 3D_PRINTING
  title        String
  description  String
  materials    String?
  applications String?
  capabilities String?
  displayOrder Int      @default(0)
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MachiningRequest {
  id                   String                 @id @default(cuid())
  referenceNo          String                 @unique
  name                 String
  company              String?
  email                String
  phone                String
  serviceType          String // CNC / VMC / 3D Printing
  material             String?
  quantity             Int?
  requiredDeliveryDate DateTime?
  tolerance            String?
  instructions         String?
  status String @default("NEW")
  quotationAmount      Float?
  estimatedDelivery    String?
  adminNotes           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  files UploadedFile[]
}

model UploadedFile {
  id                 String            @id @default(cuid())
  originalName       String
  storedName         String
  mimeType           String
  size               Int
  machiningRequestId String?
  machiningRequest   MachiningRequest? @relation(fields: [machiningRequestId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
}

// ---------- PROJECTS ----------

model Project {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  category            String
  shortDescription    String
  detailedDescription String?
  year                String?
  technologies        String? // comma separated
  clientOrEvent       String?
  coverImageUrl       String?
  status              String   @default("Published") // Published / Draft
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  images ProjectImage[]
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())
}

// ---------- CONTACT ----------

model ContactMessage {
  id          String        @id @default(cuid())
  referenceNo String        @unique
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  status String @default("NEW")
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ---------- ACCOUNTING (PRIVATE / ADMIN ONLY) ----------

model IncomeTransaction {
  id              String   @id @default(cuid())
  date            DateTime
  amount          Float
  source          String // Arena Rental / Training / Machining / Project / Sponsorship / Other
  description     String?
  paymentMethod   String?
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ExpenseTransaction {
  id              String   @id @default(cuid())
  date            DateTime
  amount          Float
  paidTo          String?
  category        String // Material / Transport / Equipment / Salary / Event Expense / Maintenance / Other
  description     String?
  paymentMethod   String?
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  slotLabel String   @unique // Partner 1 / Partner 2 / Partner 3 / Partner 4
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions PartnerTransaction[]
}

model PartnerTransaction {
  id              String   @id @default(cuid())
  partnerId       String
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  date            DateTime
  amount          Float
  reason          String?
  paymentMethod   String?
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
}

// ---------- SITE SETTINGS / CONTENT ----------

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON string
  updatedAt DateTime @updatedAt
}

model Faq {
  id           String   @id @default(cuid())
  category     String // Arena / Training / Machining / General
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model ArenaPhoto {
  id           String   @id @default(cuid())
  url          String
  caption      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

// ---------- AUDIT LOG ----------

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String? // AdminUser.id — nullable so a deleted admin's history survives
  actorName   String // snapshot at the time of the action, in case the admin is later renamed/deleted
  actorEmail  String
  action      String // e.g. LOGIN, LOGIN_FAILED, LOGOUT, CREATE, UPDATE, DELETE
  entityType  String // e.g. Project, Certificate, Settings, Income, Partner
  entityId    String?
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
  @@index([actorEmail])
}

// ---------- BILLING (INVOICES & QUOTATIONS) ----------

model Invoice {
  id                       String   @id @default(cuid())
  invoiceNumber            String   @unique // e.g. "2026-27/1"
  financialYear            String // e.g. "2026-27" — used to compute the next sequence number
  sequence                 Int
  date                     DateTime
  dueDate                  DateTime?
  billToName               String
  billToAddress            String
  billToPincode            String?
  billToGstin              String?
  billToState              String?
  placeOfSupply            String?
  items                    String // JSON: [{name, hsnSac, quantity, pricePerUnit, gstRate}]
  subTotal                 Float
  discountType             String   @default("FLAT") // FLAT or PERCENT
  discountValue            Float    @default(0)
  discountAmount           Float    @default(0)
  cgstAmount               Float    @default(0)
  sgstAmount               Float    @default(0)
  igstAmount               Float    @default(0)
  totalTax                 Float
  totalAmount              Float
  receivedAmount           Float    @default(0)
  balanceAmount            Float
  amountInWords            String?
  notes                    String?
  status                   String   @default("DRAFT") // DRAFT / SENT / PAID / PARTIALLY_PAID / CANCELLED
  linkedMachiningRequestId String?
  incomeTransactionId      String? // set when status -> PAID auto-records income; cleared if un-marked
  createdByEmail           String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([financialYear])
}

model Quotation {
  id                       String   @id @default(cuid())
  quotationNumber          String   @unique // e.g. "QT-2026-27/1"
  financialYear            String
  sequence                 Int
  date                     DateTime
  validUntil               DateTime?
  billToName               String
  billToAddress            String
  billToPincode            String?
  billToGstin              String?
  billToState              String?
  placeOfSupply            String?
  items                    String
  subTotal                 Float
  discountType             String   @default("FLAT") // FLAT or PERCENT
  discountValue            Float    @default(0)
  discountAmount           Float    @default(0)
  cgstAmount               Float    @default(0)
  sgstAmount               Float    @default(0)
  igstAmount               Float    @default(0)
  totalTax                 Float
  totalAmount              Float
  amountInWords            String?
  notes                    String?
  status                   String   @default("DRAFT") // DRAFT / SENT / ACCEPTED / REJECTED / EXPIRED
  linkedMachiningRequestId String?
  createdByEmail           String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([financialYear])
}

// ---------- ANALYTICS (SELF-HOSTED PAGE VIEWS) ----------

model PageView {
  id        String   @id @default(cuid())
  page      String   // e.g. "/machining"
  referrer  String?  // document.referrer (trimmed to origin)
  device    String?  // "desktop" | "mobile" | "tablet"
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([page])
}
